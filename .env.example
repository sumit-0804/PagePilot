# Copy to .env and fill in. Never commit .env.

# Server
API_PORT=8080
# Comma-separated list of allowed browser origins (CORS)
FRONTEND_URL=http://localhost:5173

# Groq LLM
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings: Cloudflare Workers AI through its OpenAI-compatible endpoint (free: 10,000 Neurons a day,
# about 9M tokens with this model). Create a token with the "Workers AI" template in the Cloudflare dashboard.
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1
EMBEDDING_API_KEY=your_cloudflare_workers_ai_token
EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b
# Must match the document_chunks.embedding column (vector(1024)); the API refuses to start otherwise.
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=100
# Put before search questions only ("\n" becomes a newline). Measured on the eval set: slightly better ranking.
EMBEDDING_QUERY_PREFIX=Instruct: Given a student's question, retrieve passages from their study documents that answer it\nQuery:
#
# Standby: Gemini at 1024 dimensions. Switching models needs every document re-indexed, because vectors
# from different models can't be compared; use EMBEDDING_PROVIDER=gemini, EMBEDDING_MODEL=gemini-embedding-2,
# leave EMBEDDING_QUERY_PREFIX empty, and set the limits below from your Google AI Studio rate-limit page.
EMBEDDING_RPM=100
EMBEDDING_TPM=30000
EMBEDDING_RPD=1000
# Also used for OCR below.
GEMINI_API_KEY=your_gemini_api_key

# OCR for scanned pages: gemini (uses GEMINI_API_KEY) or none
OCR_PROVIDER=gemini
OCR_MODEL=gemini-3.5-flash-lite
# Copy these from your AI Studio rate-limit page for OCR_MODEL; each request reads up to OCR_PAGES_PER_CALL pages.
OCR_RPM=10
OCR_TPM=250000
OCR_RPD=250
OCR_PAGES_PER_CALL=10
# Documents with more scanned pages than this fail with a clear message, to protect the daily quota.
OCR_MAX_PAGES=100

# Web search for the chat agent: tavily or none. Get a key at https://app.tavily.com (each search costs 1 credit).
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key
WEB_SEARCH_MAX_RESULTS=5

# Supabase. Local values come from `bunx supabase status` after `bunx supabase start`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Backend only. Never expose this to the browser.
SUPABASE_SECRET_KEY=your_secret_key
# Only needed for projects that still sign tokens with the legacy HS256 secret.
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
STORAGE_BUCKET=pdfs

# Frontend (read by Vite from this file; exposed to the browser, so never put secrets in VITE_ variables)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# /api goes through the Vite dev proxy; set the full API URL when the frontend is hosted separately.
VITE_API_URL=/api
# hCaptcha site key; set it when Supabase Auth has the captcha check on. Leave empty locally.
VITE_HCAPTCHA_SITE_KEY=

# Observability; everything here is optional and off when empty.
# production, staging or development; tags traces and errors.
DEPLOYMENT_ENVIRONMENT=development
# Langfuse traces for the AI routes (chat, generation, uploads). EU: https://cloud.langfuse.com, US: https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Share of traces kept (0-1). Lower it if Langfuse's free quota runs low.
OTEL_TRACES_SAMPLER_ARG=1
# Prompts and answers are NOT recorded unless this is SPAN_ONLY.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=
# Sentry error reporting: one project for the API, one for the frontend. DSNs are not secrets.
SENTRY_DSN=
VITE_SENTRY_DSN=
# Optional overrides; on Vercel the environment and release come from VERCEL_ENV and the commit.
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Evaluations (go run ./cmd/eval). The eval only touches a local database unless -allow-remote-db is given.
EVAL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Judge model; defaults to GROQ_MODEL.
EVAL_JUDGE_MODEL=

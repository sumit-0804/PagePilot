# Copy to .env and fill in. Never commit .env.

# Server
API_PORT=8080
# Comma-separated list of allowed browser origins (CORS)
FRONTEND_URL=http://localhost:5173

# Groq LLM
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings: gemini (default) or openai (any OpenAI-compatible /embeddings endpoint, e.g. Ollama)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
GEMINI_API_KEY=your_gemini_api_key
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=100
# Copy these from your Google AI Studio rate-limit page; they are per Google Cloud project.
EMBEDDING_RPM=100
EMBEDDING_TPM=30000
EMBEDDING_RPD=1000
# Only for EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Supabase. Local values come from `bunx supabase status` after `bunx supabase start`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Backend only. Never expose this to the browser.
SUPABASE_SECRET_KEY=your_secret_key
# Only needed for projects that still sign tokens with the legacy HS256 secret.
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
STORAGE_BUCKET=pdfs
